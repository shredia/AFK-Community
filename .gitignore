# --- Código: se sube. Datos personales, descargas y archivos generados: NUNCA se suben ---

# Python y entorno de desarrollo
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# Editores y sistema
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
~$*
*.log
*.tmp
*.nuevo

# Tus datos: cuentas, sesión, credenciales, preferencias, descargas, respaldos e importados (desde la 1.2.1)
datos_usuario/

# Ubicación antigua de esos datos (hasta la 1.2.0; la app los mueve sola a datos_usuario/)
perfil_esperian/
cuentas/
config_credenciales.json
game_accounts.json
sources_guardados.json
preferencias.json
api.txt
actualizacion.json

# Archivos que descargas del sitio para importar (datos personales, pesan ~75 MB)
afk-*.json

# Descargas (se regeneran desde el sitio)
assets/
guias/

# Tus datos editables de la Fractura (la app parte de recursos/ si faltan)
datos/

# Copias de seguridad que hace el actualizador
respaldos/

# Versión portable e instalador: se generan con herramientas/construir_exe.py y se suben al Release, no al código
build/
dist/
*.spec
*.exe
*.zip
prueba_exe.txt

# Guías: desactivadas por ahora (en desarrollo para una versión futura). El código queda solo en local.
aplicacion/ventana_guias.py
aplicacion/ventana_perfil_guia.py
navegador/guias.py
navegador/guias_datos.py
navegador/guias_perfiles.py
